# Wrapped, not self-packed: the container is fantastic-packages' own apk from
# their 25.12 luci feed, the site the project's README sends users to.

# The interface's control declares mihomo, firewall4, yq, wget-ssl,
# coreutils-timeout and the two kmods, so those ride in from the device's feed
# rather than being bundled here — mihomo is not in the official OpenWrt feeds,
# and the fantastic-packages feed has to be enabled for the app to start.
# luci-base is declared because the control does not list it.
app = luci-app-fchomo
app_i18n = luci-i18n-fchomo-{lang}
base = luci-base
