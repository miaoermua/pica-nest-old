pkgname = python3-requests
appname = python3-requests
pkgver = 2.32.5
pkgrel = 1
os = openwrt
platform = all
arch = all
pica = 0.3.34
pkgdesc = HTTP library for Python.
url = https://requests.readthedocs.io/
branch = master
protocol = cli
license = Apache-2.0
visibility = open
packager = pica-pack
type = cli
targets = apk

# Wrapped, not self-packed: the container is the feed's own python3-requests
# apk. requests itself needs only python3-light; urllib3 is what pulls the full
# python3 metapackage (and with it _ssl) in from the feed. chardet, idna,
# urllib3 and certifi are the container's own Depends, so they are not repeated
# here — only the runtime pica should check before the install.
app = python3-requests
base = python3-light
