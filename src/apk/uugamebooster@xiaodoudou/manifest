appname = luci-app-uugamebooster
pkgver = 2.0
pkgrel = 1
os = openwrt
platform = all
arch = all
pica = 0.4.4
pkgdesc = LuCI interface for NetEase UU Game Booster, for configuring the acceleration routes it applies to a device.
url = https://github.com/xiaodoudou/luci-app-uugamebooster
luci_url = https://github.com/xiaodoudou/luci-app-uugamebooster
branch = master
