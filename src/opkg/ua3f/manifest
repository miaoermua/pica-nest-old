pkgname = ua3f
appname = ua3f
pkgver = 3.7.0
pkgrel = 1
os = openwrt
platform = all
arch = all
pica = 0.4.4
pkgdesc = A lightweight uclient-fetch alternative for OpenWrt, with a LuCI interface and support for nftables.
url = https://github.com/SunBK201/UA3F
branch = main
protocol = luci
luci_desc = UA3F LuCI interface
license = GPL-3.0-only
visibility = open
packager = pica-pack
type = luci
luci = lua1
targets = opkg
app = ua3f

# The upstream ipk records these, and they are not optional: the proxy needs
# luci-compat for its LuCI pages and the iptables modules for the modes it
# offers. `app` is the ipk itself; the rest are what it needs beside it.
base = luci-compat
base = ipset
base = iptables
base = iptables-mod-tproxy
base = iptables-mod-extra
base = iptables-mod-ipopt
base = iptables-mod-nfqueue
base = iptables-mod-conntrack-extra
kmod = kmod-nf-conntrack-netlink
