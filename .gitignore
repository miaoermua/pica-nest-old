# Local agent cache docs (do not upload)

example/*
docs/local_agent_cache/*

# Build artifacts fetched from upstream are regenerated by CI, never committed.
pkgs/
binary/

# Built packages are build output. They are published to GitHub Releases and
# referenced by `download_url` in r/repo.json; the repository tracks metadata
# only. `check_no_binaries.py` enforces this — the rules below only keep a stray
# local build out of `git status`.
#
# Deliberately not `*.tar.gz`: upstream source archives under src/ are real
# inputs and must stay trackable.
*.pkg.tar.gz
*.ipk
*.apk
*.adb
r/packages/
src/*/out/
dist/

# CI workspace
build_output/
__pycache__/
*.pyc

# Schema cache
.schema-cache/

# Local mirror cache, written by scripts/serve_mirror.py
.mirror-cache/

.codebuddy/*
.workbuddy/*

# macOS Finder metadata
.DS_Store
