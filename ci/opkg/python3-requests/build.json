{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "python3-requests",
  "enabled": true,
  "manifest": "src/opkg/python3-requests/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.openwrt.org/releases/24.10.8/packages/{arch}/packages/python3-requests_2.32.3-r2_{arch}.ipk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "2.32.3"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 2
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "keep_release_history": 1
  }
}
