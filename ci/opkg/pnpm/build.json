{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "pnpm",
  "enabled": true,
  "manifest": "src/opkg/pnpm/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/packages/node-pnpm_10.33.0-r1_{arch}.ipk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "10.33.0"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "keep_release_history": 1
  }
}
