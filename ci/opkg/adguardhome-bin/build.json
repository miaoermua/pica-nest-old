{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "adguardhome-bin",
  "enabled": true,
  "manifest": "src/opkg/adguardhome-bin/manifest",
  "source": {
    "provider": "http_template",
    "url_template": "https://downloads.openwrt.org/releases/24.10.8/packages/{arch}/packages/adguardhome_0.107.57-r1_{arch}.ipk",
    "version": "0.107.57-r1"
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "0.107.57"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/opkg/adguardhome-bin/db.json",
    "keep_release_history": 1
  }
}
