{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "luci-theme-footstrap",
  "enabled": true,
  "manifest": "src/opkg/luci-theme-footstrap/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://repo.owfeed.org/releases/24.10/{arch}/luci-theme-footstrap_0.14.16-r1_all.ipk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "0.14.16"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "keep_release_history": 1
  }
}
