{
  "schema": "pica-ci-job-v1",
  "mgr": "apk",
  "id": "luci-app-tailscale-community",
  "enabled": true,
  "manifest": "src/apk/luci-app-tailscale-community/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.openwrt.org/releases/25.12.0/packages/{arch}/luci/luci-app-tailscale-community-26.288.56989~75a306d.apk",
      "https://downloads.openwrt.org/releases/25.12.0/packages/{arch}/luci/luci-i18n-tailscale-community-zh-cn-26.288.56989~75a306d.apk",
      "https://downloads.openwrt.org/releases/25.12.0/packages/{arch}/packages/tailscale-1.104.1-r1.apk",
      "https://downloads.openwrt.org/releases/25.12.0/packages/{arch}/base/ip-full-6.18.0-r2.apk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "1.104.1"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/apk/luci-app-tailscale-community/db.json",
    "keep_release_history": 1
  }
}
