{
  "schema": "pica-ci-job-v1",
  "mgr": "apk",
  "id": "qbittorrent",
  "enabled": true,
  "manifest": "src/apk/qbittorrent/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.immortalwrt.org/releases/25.12.2/packages/{arch}/luci/luci-app-qbittorrent-26.236.50544~cb5d434.apk",
      "https://downloads.immortalwrt.org/releases/25.12.2/packages/{arch}/packages/qbittorrent-5.2.3-r2.apk",
      "https://downloads.immortalwrt.org/releases/25.12.2/packages/{arch}/luci/luci-i18n-qbittorrent-zh-cn-26.236.50544~cb5d434.apk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "5.2.3"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 2
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/apk/qbittorrent/db.json",
    "keep_release_history": 1
  }
}
